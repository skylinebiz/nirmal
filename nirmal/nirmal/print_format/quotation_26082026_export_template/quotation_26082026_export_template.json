 "creation": "2026-08-26 12:42:53.550643",
 "css": "html, body {\n    margin: 0 !important;\n    padding: 0 !important;\n    box-sizing: border-box;\n}\n\n.footer-pad{\n    padding-bottom:1rem;\n    padding-right:2rem;\n}\n\n.print-format > *:not(.print-heading) {\n    padding-top: 1rem !important;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Quotation",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n \r\n\r\n  \r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .border td,\r\n    .border th {\r\n        border: 1px solid #000;\r\n        vertical-align: top;\r\n        /* line-height: 2; */\r\n    }\r\n\r\n    .center {\r\n        text-align: center;\r\n    }\r\n\r\n    .right {\r\n        text-align: right;\r\n    }\r\n\r\n    .bold {\r\n        font-weight: bold;\r\n    }\r\n\r\n    .title {\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .small {\r\n        font-size: 9px;\r\n    }\r\n\r\n    .header td {\r\n        border: none;\r\n    }\r\n\r\n    .items th {\r\n        background: #f4f4f4;\r\n    }\r\n\r\n    .signature {\r\n        height: 70px;\r\n    }\r\n\r\n    .page-break {\r\n        page-break-after: always;\r\n    }\r\n\r\n    .ql-editor {\r\n        padding: 0 !important;\r\n        margin: 0 !important;\r\n        min-height: auto !important;\r\n        height: auto !important;\r\n        overflow: visible !important;\r\n        line-height: 1 !important;\r\n    }\r\n\r\n    .ql-editor p {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n        line-height: 1.4 !important;\r\n    }\r\n\r\n    .letter-head {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n\r\n\r\n    .items {\r\n        page-break-inside: auto;\r\n    }\r\n\r\n    .items tr {\r\n        page-break-inside: avoid;\r\n        page-break-after: auto;\r\n    }\r\n\r\n    .items td {\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    tfoot {\r\n        display: table-footer-group;\r\n    }\r\n\r\n    .items {\r\n        border-collapse: collapse;\r\n    }\r\n</style>\r\n\r\n<div id=\"header-html\" class=\"hidden-pdf\" style=\"padding-bottom:0!important;padding-top: 2rem !important;\">\r\n    {{ letter_head }}\r\n</div>\r\n\r\n\r\n\r\n{% set company = frappe.get_cached_doc(\"Company\", doc.company) %}\r\n\r\n{% if doc.customer_address %}\r\n    {% set customer_address = frappe.get_cached_doc(\"Address\", doc.customer_address) %}\r\n{% endif %}\r\n\r\n{% set is_overseas = (\r\n    customer_address\r\n    and company.country\r\n    and customer_address.country\r\n    and company.country != customer_address.country\r\n) %}\r\n\r\n\r\n<!-- BUYER + TERMS / EXPORT DETAILS -->\r\n<table class=\"border\"\r\n       style=\"width:100%; border-collapse:collapse; table-layout:fixed;\">\r\n\r\n    <!-- BUYER / ENQUIRY -->\r\n    <tr>\r\n\r\n        <!-- BUYER -->\r\n        <td colspan=\"2\"\r\n            width=\"50%\"\r\n            style=\"padding:0; vertical-align:top;\">\r\n\r\n            <b>Buyer</b><br>\r\n\r\n            {{ doc.customer_name }}<br>\r\n\r\n            {% if customer_address %}\r\n\r\n                {{ customer_address.address_line1 }}<br>\r\n\r\n                {% if customer_address.address_line2 %}\r\n                    {{ customer_address.address_line2 }}<br>\r\n                {% endif %}\r\n\r\n                {{ customer_address.city }}\r\n\r\n                {% if customer_address.pincode %}\r\n                    {{ customer_address.pincode }}\r\n                {% endif %}\r\n                <br>\r\n\r\n                {% if customer_address.state %}\r\n                    {{ customer_address.state }}<br>\r\n                {% endif %}\r\n\r\n                {% if is_overseas %}\r\n\r\n                    {{ customer_address.country }}<br>\r\n\r\n                {% else %}\r\n\r\n                    State Code :\r\n                    {{ customer_address.gst_state_number }}<br>\r\n\r\n                {% endif %}\r\n\r\n            {% endif %}\r\n\r\n            {% if doc.billing_address_gstin and not is_overseas %}\r\n                GST: {{ doc.billing_address_gstin }}\r\n            {% endif %}\r\n\r\n        </td>\r\n\r\n\r\n        <!-- ENQUIRY -->\r\n        <td colspan=\"2\"\r\n            width=\"50%\"\r\n            style=\"padding:0; vertical-align:top;\">\r\n\r\n            <div>\r\n                <b>Buyer's Purchase Enquiry No:</b>\r\n                {{ doc.custom_purchase_enquiry_no or \"\" }}\r\n            </div>\r\n\r\n            <div style=\"margin-top:4px;\">\r\n                <b>Enquiry Date:</b>\r\n                {{ frappe.utils.formatdate(doc.custom_purchase_enquiry_date)\r\n                    if doc.custom_purchase_enquiry_date else \"\" }}\r\n            </div>\r\n\r\n\r\n            {% if not is_overseas %}\r\n\r\n                <!-- DOMESTIC TERMS -->\r\n                <div style=\"border-top:1px solid #000;\r\n                            margin-top:4px;\r\n                            padding-top:2px;\">\r\n\r\n                    <b>{{ doc.tc_name }}</b>\r\n\r\n                </div>\r\n\r\n                <div style=\"line-height:2;\">\r\n                    {{ doc.terms }}\r\n                </div>\r\n\r\n            {% endif %}\r\n\r\n        </td>\r\n\r\n    </tr>\r\n\r\n\r\n    {% if is_overseas %}\r\n\r\n        <!-- OVERSEAS EXPORT DETAILS - ROW 1 -->\r\n\r\n        <tr>\r\n\r\n            <!-- PRE-CARRIAGE -->\r\n            <td width=\"17.5%\"\r\n                class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       \">\r\n\r\n                <span>\r\n                    Pre-Carriage by\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ doc.custom_nirmal_precarriage_by or \"\" }}\r\n\r\n            </td>\r\n\r\n\r\n            <!-- PLACE OF RECEIPT -->\r\n            <td width=\"32.5%\"\r\n                class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       \">\r\n\r\n                <span>\r\n                    Place of Receipt by Pre-Carrier\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ doc.custom_nirmal_place_of_receipt or \"\" }}\r\n\r\n            </td>\r\n\r\n\r\n            <!-- COUNTRY OF ORIGIN -->\r\n            <td width=\"25%\"\r\n                class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       \">\r\n\r\n                <span>\r\n                    Country of Origin of Goods\r\n                </span>\r\n\r\n                <br>\r\n\r\n                  {{ company.country or \"\" }}\r\n\r\n            </td>\r\n\r\n\r\n            <!-- FINAL DESTINATION COUNTRY -->\r\n            <td width=\"25%\"\r\n                class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       \">\r\n\r\n                <span>\r\n                    Country of Final Destination\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ customer_address.country or \"\" }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n\r\n            <!-- VESSEL / FLIGHT -->\r\n            <td class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       white-space:nowrap;\">\r\n\r\n                <span>\r\n                    Vessel / Flight No.\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ doc.custom_nirmal_vessel_no or \"\" }}\r\n\r\n            </td>\r\n\r\n\r\n            <!-- PORT OF LOADING -->\r\n            <td class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       white-space:nowrap;\">\r\n\r\n                <span>\r\n                    Port of Loading\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ doc.custom_nirmal_port_of_loading or \"\" }}\r\n\r\n            </td>\r\n\r\n\r\n            <!-- TERMS -->\r\n            <td colspan=\"2\"\r\n                rowspan=\"2\"\r\n                style=\"padding:4px;\r\n                       vertical-align:top;\">\r\n\r\n                <b>TERMS OF DELIVERY &amp; PAYMENTS :-</b>\r\n\r\n                <div style=\"line-height:1.5;\r\n                            margin-top:4px;\">\r\n\r\n                    {{ doc.terms or \"\" }}\r\n\r\n                </div>\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        <tr>\r\n\r\n            <!-- PORT OF DESTINATION -->\r\n            <td class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       white-space:nowrap;\">\r\n\r\n                <span>\r\n                    Port of Destination\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ doc.custom_nirmal_port_of_destination or \"\" }}\r\n\r\n            </td>\r\n\r\n\r\n            <!-- FINAL DESTINATION -->\r\n            <td class=\"center\"\r\n                style=\"vertical-align:middle;\r\n                       white-space:nowrap;\">\r\n\r\n                <span>\r\n                    Final Destination\r\n                </span>\r\n\r\n                <br>\r\n\r\n                {{ doc.custom_nirmal_final_destination or \"\" }}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n\r\n    {% endif %}\r\n\r\n</table>\r\n\r\n<!--  ITEMS  -->\r\n\r\n{% set hsn_codes = [] %}\r\n{% for item in doc.items %}\r\n{% if item.gst_hsn_code and item.gst_hsn_code not in hsn_codes %}\r\n{% set _ = hsn_codes.append(item.gst_hsn_code) %}\r\n{% endif %}\r\n{% endfor %}\r\n\r\n<table class=\"border items\">\r\n\r\n    <thead>\r\n        <tr>\r\n            <th width=\"1%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                S.No.\r\n            </th>\r\n\r\n            <th width=\"43%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Description</b>\r\n                {% if hsn_codes %}\r\n                <br>\r\n                HSN: {{ hsn_codes | join(\", \") }}\r\n                {% endif %}\r\n            </th>\r\n\r\n            <th width=\"12%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Delivery</b>\r\n            </th>\r\n\r\n            <th width=\"10%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Unit</b>\r\n            </th>\r\n\r\n            <th width=\"8%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Qty.</b>\r\n            </th>\r\n\r\n            <th width=\"13%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>\r\n                    {% if is_overseas %}\r\n                        Price Ex-Works in {{ doc.currency }}\r\n                    {% else %}\r\n                        Price / Each<br>{{ doc.currency }}\r\n                    {% endif %}\r\n                </b>\r\n            </th>\r\n            \r\n            <th width=\"15%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>\r\n                    {% if is_overseas %}\r\n                        Amount Ex-Works in {{ doc.currency }}\r\n                    {% else %}\r\n                        Amount\r\n                    {% endif %}\r\n                </b>\r\n            </th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for item in doc.items %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"center\">\r\n                {{ loop.index }}\r\n            </td>\r\n\r\n            <td>\r\n                <div>\r\n                    {{ item.item_name }}\r\n                </div>\r\n\r\n                <small>\r\n                    {% if item.item_code and item.item_code != item.item_name %}\r\n                    <div>Part No: {{ item.item_code }}</div>\r\n                    {% endif %}\r\n\r\n                    {% if item.description %}\r\n                    <div>{{ item.description }}</div>\r\n                    {% endif %}\r\n                </small>\r\n            </td>\r\n\r\n            <td class=\"center\" style=\"white-space: nowrap;\">\r\n                {{ item.custom_delivery_date_range or \"-\" }}\r\n            </td>\r\n\r\n            <td class=\"center\">\r\n                {{ item.uom }}\r\n            </td>\r\n\r\n            <td class=\"center\">\r\n                {{ \"{:g}\".format(item.qty) }}\r\n            </td>\r\n\r\n            <td class=\"right\">\r\n                {{ frappe.utils.fmt_money(item.rate) }}\r\n            </td>\r\n\r\n            <td class=\"right\">\r\n                {{ frappe.utils.fmt_money(item.amount) }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endfor %}\r\n    </tbody>\r\n\r\n    <tbody class=\"totals\">\r\n\r\n        <!-- Total Qty + Sub Total -->\r\n        <tr>\r\n            <td colspan=\"4\" class=\"right bold\">\r\n                Total\r\n            </td>\r\n\r\n            <td class=\"center bold\">\r\n                {{ \"{:g}\".format(doc.total_qty) }}\r\n            </td>\r\n\r\n            <td><b>Sub Total</b></td>\r\n\r\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n\r\n        {% set ns = namespace(\r\n        total_before_tax=doc.net_total,\r\n        before_tax=[],\r\n        gst=[]\r\n        ) %}\r\n\r\n        {% if doc.taxes %}\r\n        {% for tax in doc.taxes %}\r\n        {% set account = frappe.get_cached_doc(\"Account\", tax.account_head) %}\r\n\r\n        {% if account.account_type == \"Tax\" %}\r\n        {% set _ = ns.gst.append(tax) %}\r\n        {% else %}\r\n        {% set _ = ns.before_tax.append(tax) %}\r\n        {% set ns.total_before_tax = tax.total %}\r\n        {% endif %}\r\n        {% endfor %}\r\n        {% endif %}\r\n\r\n        <!-- Charges Before Tax -->\r\n        {% for tax in ns.before_tax %}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                Add: {{ tax.description or tax.account_head }}\r\n                {% if tax.rate %}\r\n                ({{ \"{:g}\".format(tax.rate) }}%)\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"right\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n        <!-- Total Before Tax -->\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                <b>Total Before Tax</b>\r\n            </td>\r\n\r\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(ns.total_before_tax, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n\r\n        <!-- GST / Tax Accounts -->\r\n        {% for tax in ns.gst %}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                Add: {{ tax.description or tax.account_head }}\r\n                {% if tax.rate %}\r\n                ({{ \"{:g}\".format(tax.rate) }}%)\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"right\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n        <!-- Discount -->\r\n        {% if doc.discount_amount %}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                Discount\r\n                {% if doc.additional_discount_percentage %}\r\n                ({{ doc.additional_discount_percentage }}%)\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"right\">\r\n                -{{ frappe.utils.fmt_money(doc.discount_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n        {% endif %}\r\n\r\n        <!-- Total After Tax -->\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                <b>Total After Tax</b>\r\n            </td>\r\n\r\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n            <td colspan=\"7\"\r\n                style=\"padding:8px;{% if is_overseas %} background-color:#f2dada;{% endif %}\">\r\n                <b>Amount in Words in:</b>\r\n                {{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n<!-- Footer -->\r\n<!--<div id=\"footer-html\" class=\"visible-pdf\">-->\r\n    {{ footer }}\r\n<!--</div>-->\r\n\r\n<div id=\"footer-html\">\r\n    <div class=\"row text-muted\" style=\"font-size: 10px;\">\r\n        <div class=\"col-xs-12 text-right footer-pad\">\r\n            <p>Page <span class=\"page\"></span> of <span class=\"topage\"></span></p>\r\n        </div>\r\n    </div>\r\n</div>",
