 "creation": "2026-11-17 13:30:20.032102",
 "css": "@media print {\n    body { margin: 0 !important; padding: 0 !important; }\n    .print-format { padding: 0 !important; }\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Quotation",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 10mm;\n    }\n\n    body {\n        font-family: Arial, Helvetica, sans-serif;\n        font-size: 10px;\n        color: #000;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .border td,\n    .border th {\n        border: 1px solid #000;\n        vertical-align: top;\n        /* line-height: 2; */\n    }\n\n    .center {\n        text-align: center;\n    }\n\n    .right {\n        text-align: right;\n    }\n\n    .bold {\n        font-weight: bold;\n    }\n\n    .title {\n        font-size: 18px;\n        font-weight: bold;\n    }\n\n    .small {\n        font-size: 9px;\n    }\n\n    .header td {\n        border: none;\n    }\n\n    .items th {\n        background: #f4f4f4;\n    }\n\n    .signature {\n        height: 70px;\n    }\n\n    .page-break {\n        page-break-after: always;\n    }\n\n    .ql-editor {\n        padding: 0 !important;\n        margin: 0 !important;\n        min-height: auto !important;\n        height: auto !important;\n        overflow: visible !important;\n        line-height: 1 !important;\n    }\n\n    .ql-editor p {\n        margin: 0 !important;\n        padding: 0 !important;\n        line-height: 1.4 !important;\n    }\n\n    .letter-head {\n        margin: 0 !important;\n        padding: 0 !important;\n    }\n\n\n    .items {\n        page-break-inside: auto;\n    }\n\n    .items tr {\n        page-break-inside: avoid;\n        page-break-after: auto;\n    }\n\n    .items td {\n        page-break-inside: avoid;\n    }\n\n    thead {\n        display: table-header-group;\n    }\n\n    tfoot {\n        display: table-footer-group;\n    }\n\n    .items {\n        border-collapse: collapse;\n    }\n</style>\n\n\n{%- macro add_header(letter_head, no_letterhead) -%}\n{% if letter_head and not no_letterhead %}\n<div class=\"letter-head\">\n    {{ letter_head }}\n</div>\n{% endif %}\n{%- endmacro -%}\n\n\n<div {% if print_settings and print_settings.repeat_header_footer %} id=\"header-html\" class=\"hidden-pdf\"\n    style=\"margin: 0 !important;\" {% endif %}>\n<div class=\"page-edge-space\" style=\"height: 8mm;\"></div>\n    {{ add_header( letter_head, no_letterhead) }}\n    \n<div style=\"\n    width:100%;\n    background:#fff200;\n    border:1px solid #000;\n    padding:8px;\n    text-align:center;\n    box-sizing:border-box;\n    margin-top:-1px;\n\">\n    <span >\n       <b>{{ doc.select_print_heading or \"QUOTATION CUM PERFORMA INVOICE\" }}</b><br>\n        <b>No. {{ doc.name }}</b>\n        &nbsp;&nbsp;&nbsp;\n        <b>Dated: {{ frappe.utils.formatdate(doc.transaction_date) }}</b>\n    </span>\n\n</div>\n</div>\n\n\n<!--  BUYER + TERMS  -->\n\n<table class=\"border\">\n\n    <tr style=\"padding:0;\">\n\n        <td width=\"50%\" style=\"padding:0;\">\n\n            <b>Buyer</b><br>\n\n            {{ doc.customer_name }}<br>\n\n            {% if doc.customer_address %}\n            {% set customer_address = frappe.get_doc(\"Address\", doc.customer_address) %}\n\n            {{ customer_address.address_line1 }}<br>\n\n            {% if customer_address.address_line2 %}\n            {{ customer_address.address_line2 }}<br>\n            {% endif %}\n\n            {{ customer_address.city }}\n            {{ customer_address.pincode }}<br>\n\n            State Code :\n            {{ customer_address.gst_state_number or \"\" }}<br>\n            Phone: {{ customer_address.phone or \"\" }}<br>\n\n            {% endif %}\n\n\n            {% if doc.billing_address_gstin %}\n            GST: {{ doc.billing_address_gstin }}\n            {% endif %}\n\n        </td>\n\n        <td width=\"50%\">\n            <div>Buyer's Purchase Enquiry No:\n                <span>\n                    {{ doc.custom_purchase_enquiry_no or \"\" }}\n                </span>\n            </div>\n\n            <div style=\"margin-top:4px;\">Enquiry Date:\n\n                <span>\n\n                    {{ frappe.utils.formatdate(doc.custom_purchase_enquiry_date) if doc.custom_purchase_enquiry_date\n                    else \"\" }}\n                </span>\n            </div>\n\n\n            <div style=\"border-top:1px solid #000; margin-top:4px; padding-top:2px;\">\n                <b>{{ doc.tc_name }}</b>\n            </div>\n\n            <div style=\"line-height:2;\">\n                {{ doc.terms }}\n            </div>\n        </td>\n\n    </tr>\n\n</table>\n\n<!--  ITEMS  -->\n\n{% set hsn_codes = [] %}\n{% for item in doc.items %}\n{% if item.gst_hsn_code and item.gst_hsn_code not in hsn_codes %}\n{% set _ = hsn_codes.append(item.gst_hsn_code) %}\n{% endif %}\n{% endfor %}\n\n<table class=\"border items\">\n\n    <thead>\n        <tr>\n            <th width=\"1%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                S.No.\n            </th>\n\n            <th width=\"43%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                <b>Description</b>\n                {% if hsn_codes %}\n                <br>\n                <small>HSN: {{ hsn_codes | join(\", \") }}</small>\n                {% endif %}\n            </th>\n\n            <th width=\"12%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                <b>Delivery</b>\n            </th>\n\n            <th width=\"10%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                <b>Unit</b>\n            </th>\n\n            <th width=\"8%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                <b>Qty.</b>\n            </th>\n\n            <th width=\"13%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                <b>Price / Each<br>Rs.</b>\n            </th>\n\n            <th width=\"15%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\n                <b>Amount</b>\n            </th>\n        </tr>\n    </thead>\n\n    <tbody>\n\n        {% for item in doc.items %}\n\n        <tr>\n\n            <td class=\"center\">\n                {{ loop.index }}\n            </td>\n\n            <td>\n                <div>\n                    {{ item.item_name }}\n                </div>\n\n                <small>\n                    {% if item.item_code\n      and item.item_code|trim\n      and item.item_code|trim != item.item_name|trim %}\n    <div>Part No: {{ item.item_code|trim }}</div>\n{% endif %}\n\n                    {% if item.description %}\n                    <div>{{ item.description }}</div>\n                    {% endif %}\n                </small>\n            </td>\n\n            <td class=\"center\" style=\"white-space: nowrap;\">\n                {{ item.custom_delivery_date_range or \"-\" }}\n            </td>\n\n            <td class=\"center\">\n                {{ item.uom }}\n            </td>\n\n            <td class=\"center\">\n                {{ \"{:g}\".format(item.qty) }}\n            </td>\n\n            <td class=\"right\">\n                {{ frappe.utils.fmt_money(item.rate) }}\n            </td>\n\n            <td class=\"right\">\n                {{ frappe.utils.fmt_money(item.amount) }}\n            </td>\n\n        </tr>\n\n        {% endfor %}\n    </tbody>\n\n    <tbody class=\"totals\">\n\n        <!-- Total Qty + Sub Total -->\n        <tr>\n            <td colspan=\"4\" class=\"right bold\">\n                Total\n            </td>\n\n            <td class=\"center bold\">\n                {{ \"{:g}\".format(doc.total_qty) }}\n            </td>\n\n            <td><b>Sub Total</b></td>\n\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\n                {{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}\n            </td>\n        </tr>\n\n        {% set ns = namespace(\n        total_before_tax=doc.net_total,\n        before_tax=[],\n        gst=[]\n        ) %}\n\n        {% if doc.taxes %}\n        {% for tax in doc.taxes %}\n        {% set account = frappe.get_cached_doc(\"Account\", tax.account_head) %}\n\n        {% if account.account_type == \"Tax\" %}\n        {% set _ = ns.gst.append(tax) %}\n        {% else %}\n        {% set _ = ns.before_tax.append(tax) %}\n        {% set ns.total_before_tax = ns.total_before_tax + tax.tax_amount %}\n        {% endif %}\n        {% endfor %}\n        {% endif %}\n\n        <!-- Charges Before Tax -->\n        {% for tax in ns.before_tax %}\n        <tr>\n            <td colspan=\"6\" class=\"right\">\n                Add: {{ tax.description or tax.account_head }}\n                {% if tax.rate %}\n                ({{ \"{:g}\".format(tax.rate) }}%)\n                {% endif %}\n            </td>\n\n            <td class=\"right\" style=\"white-space: nowrap;\">\n                {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\n            </td>\n        </tr>\n        {% endfor %}\n\n        <!-- Total Before Tax -->\n        <tr>\n            <td colspan=\"6\" class=\"right\">\n                <b>Total Before Tax</b>\n            </td>\n\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\n                {{ frappe.utils.fmt_money(ns.total_before_tax, currency=doc.currency) }}\n            </td>\n        </tr>\n\n        <!-- GST / Tax Accounts -->\n        {% for tax in ns.gst %}\n        <tr>\n            <td colspan=\"6\" class=\"right\">\n                Add: {{ tax.description or tax.account_head }}\n                {% if tax.rate %}\n                ({{ \"{:g}\".format(tax.rate) }}%)\n                {% endif %}\n            </td>\n\n            <td class=\"right\" style=\"white-space: nowrap;\">\n                {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\n            </td>\n        </tr>\n        {% endfor %}\n\n        <!-- Discount -->\n        {% if doc.discount_amount %}\n        <tr>\n            <td colspan=\"6\" class=\"right\">\n                Discount\n                {% if doc.additional_discount_percentage %}\n                ({{ doc.additional_discount_percentage }}%)\n                {% endif %}\n            </td>\n\n            <td class=\"right\">\n                -{{ frappe.utils.fmt_money(doc.discount_amount, currency=doc.currency) }}\n            </td>\n        </tr>\n        {% endif %}\n\n        <!-- Total After Tax -->\n        <tr>\n            <td colspan=\"6\" class=\"right\">\n                <b>Total After Tax</b>\n            </td>\n\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\n                {{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\n            </td>\n        </tr>\n\n\n        <tr>\n            <td colspan=\"7\" style=\"padding:8px;\">\n                <b>Amount in Words in Rs. :</b>\n{{ frappe.utils.money_in_words(doc.grand_total, doc.currency) }}            </td>\n        </tr>\n    </tbody>\n\n</table>\n\n\n<!-- Footer -->\n<div id=\"footer-html\" class=\"visible-pdf\">\n    {% if footer and not no_letterhead %}\n    {{ footer }}\n    {% endif %}\n<div class=\"page-edge-space\" style=\"height: 8mm;\"></div>\n</div>\n\n\n",
