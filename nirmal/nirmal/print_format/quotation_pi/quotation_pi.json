 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 10mm;\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, Helvetica, sans-serif;\r\n        font-size: 10px;\r\n        color: #000;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .border td,\r\n    .border th {\r\n        border: 1px solid #000;\r\n        vertical-align: top;\r\n        /* line-height: 2; */\r\n    }\r\n\r\n    .center {\r\n        text-align: center;\r\n    }\r\n\r\n    .right {\r\n        text-align: right;\r\n    }\r\n\r\n    .bold {\r\n        font-weight: bold;\r\n    }\r\n\r\n    .title {\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .small {\r\n        font-size: 9px;\r\n    }\r\n\r\n    .header td {\r\n        border: none;\r\n    }\r\n\r\n    .items th {\r\n        background: #f4f4f4;\r\n    }\r\n\r\n    .signature {\r\n        height: 70px;\r\n    }\r\n\r\n    .page-break {\r\n        page-break-after: always;\r\n    }\r\n\r\n    .ql-editor {\r\n        padding: 0 !important;\r\n        margin: 0 !important;\r\n        min-height: auto !important;\r\n        height: auto !important;\r\n        overflow: visible !important;\r\n        line-height: 1 !important;\r\n    }\r\n\r\n    .ql-editor p {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n        line-height: 1.4 !important;\r\n    }\r\n\r\n    .letter-head {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n\r\n\r\n    .items {\r\n        page-break-inside: auto;\r\n    }\r\n\r\n    .items tr {\r\n        page-break-inside: avoid;\r\n        page-break-after: auto;\r\n    }\r\n\r\n    .items td {\r\n        page-break-inside: avoid;\r\n    }\r\n\r\n    thead {\r\n        display: table-header-group;\r\n    }\r\n\r\n    tfoot {\r\n        display: table-footer-group;\r\n    }\r\n\r\n    .items {\r\n        border-collapse: collapse;\r\n    }\r\n</style>\r\n\r\n\r\n{%- macro add_header(letter_head, no_letterhead) -%}\r\n{% if letter_head and not no_letterhead %}\r\n<div class=\"letter-head\">\r\n    {{ letter_head }}\r\n</div>\r\n{% endif %}\r\n{%- endmacro -%}\r\n\r\n\r\n<div {% if print_settings and print_settings.repeat_header_footer %} id=\"header-html\" class=\"hidden-pdf\"\r\n    style=\"margin: 0 !important;\" {% endif %}>\r\n    {{ add_header( letter_head, no_letterhead) }}\r\n    \r\n\r\n</div>\r\n\r\n\r\n<!--  BUYER + TERMS  -->\r\n\r\n<table class=\"border\">\r\n\r\n    <tr style=\"padding:0;\">\r\n\r\n        <td width=\"50%\" style=\"padding:0;\">\r\n\r\n            <b>Buyer</b><br>\r\n\r\n            {{ doc.customer_name }}<br>\r\n\r\n            {% if doc.customer_address %}\r\n            {% set customer_address = frappe.get_doc(\"Address\", doc.customer_address) %}\r\n\r\n            {{ customer_address.address_line1 }}<br>\r\n\r\n            {% if customer_address.address_line2 %}\r\n            {{ customer_address.address_line2 }}<br>\r\n            {% endif %}\r\n\r\n            {{ customer_address.city }}\r\n            {{ customer_address.pincode }}<br>\r\n\r\n            State Code :\r\n            {{ customer_address.gst_state_number }}<br>\r\n            Phone: {{ customer_address.phone }}<br>\r\n\r\n            {% endif %}\r\n\r\n\r\n            {% if doc.billing_address_gstin %}\r\n            GST: {{ doc.billing_address_gstin }}\r\n            {% endif %}\r\n\r\n        </td>\r\n\r\n        <td width=\"50%\">\r\n            <div>Buyer's Purchase Enquiry No:\r\n                <span>\r\n                    {{ doc.custom_purchase_enquiry_no or \"\" }}\r\n                </span>\r\n            </div>\r\n\r\n            <div style=\"margin-top:4px;\">Enquiry Date:\r\n\r\n                <span>\r\n\r\n                    {{ frappe.utils.formatdate(doc.custom_purchase_enquiry_date) if doc.custom_purchase_enquiry_date\r\n                    else \"\" }}\r\n                </span>\r\n            </div>\r\n\r\n\r\n            <div style=\"border-top:1px solid #000; margin-top:4px; padding-top:2px;\">\r\n                <b>{{ doc.tc_name }}</b>\r\n            </div>\r\n\r\n            <div style=\"line-height:2;\">\r\n                {{ doc.terms }}\r\n            </div>\r\n        </td>\r\n\r\n    </tr>\r\n\r\n</table>\r\n\r\n<!--  ITEMS  -->\r\n\r\n{% set hsn_codes = [] %}\r\n{% for item in doc.items %}\r\n{% if item.gst_hsn_code and item.gst_hsn_code not in hsn_codes %}\r\n{% set _ = hsn_codes.append(item.gst_hsn_code) %}\r\n{% endif %}\r\n{% endfor %}\r\n\r\n<table class=\"border items\">\r\n\r\n    <thead>\r\n        <tr>\r\n            <th width=\"1%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                S.No.\r\n            </th>\r\n\r\n            <th width=\"43%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Description</b>\r\n                {% if hsn_codes %}\r\n                <br>\r\n                <small>HSN: {{ hsn_codes | join(\", \") }}</small>\r\n                {% endif %}\r\n            </th>\r\n\r\n            <th width=\"12%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Delivery</b>\r\n            </th>\r\n\r\n            <th width=\"10%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Unit</b>\r\n            </th>\r\n\r\n            <th width=\"8%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Qty.</b>\r\n            </th>\r\n\r\n            <th width=\"13%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Price / Each<br>Rs.</b>\r\n            </th>\r\n\r\n            <th width=\"15%\" style=\"text-align:center; color:#000; background-color:#d9eaf2;\">\r\n                <b>Amount</b>\r\n            </th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n\r\n        {% for item in doc.items %}\r\n\r\n        <tr>\r\n\r\n            <td class=\"center\">\r\n                {{ loop.index }}\r\n            </td>\r\n\r\n            <td>\r\n                <div>\r\n                    {{ item.item_name }}\r\n                </div>\r\n\r\n                <small>\r\n                    {% if item.item_code and item.item_code != item.item_name %}\r\n                    <div>Part No: {{ item.item_code }}</div>\r\n                    {% endif %}\r\n\r\n                    {% if item.description %}\r\n                    <div>{{ item.description }}</div>\r\n                    {% endif %}\r\n                </small>\r\n            </td>\r\n\r\n            <td class=\"center\" style=\"white-space: nowrap;\">\r\n                {{ item.custom_delivery_date_range or \"-\" }}\r\n            </td>\r\n\r\n            <td class=\"center\">\r\n                {{ item.uom }}\r\n            </td>\r\n\r\n            <td class=\"center\">\r\n                {{ \"{:g}\".format(item.qty) }}\r\n            </td>\r\n\r\n            <td class=\"right\">\r\n                {{ frappe.utils.fmt_money(item.rate) }}\r\n            </td>\r\n\r\n            <td class=\"right\">\r\n                {{ frappe.utils.fmt_money(item.amount) }}\r\n            </td>\r\n\r\n        </tr>\r\n\r\n        {% endfor %}\r\n    </tbody>\r\n\r\n    <tbody class=\"totals\">\r\n\r\n        <!-- Total Qty + Sub Total -->\r\n        <tr>\r\n            <td colspan=\"4\" class=\"right bold\">\r\n                Total\r\n            </td>\r\n\r\n            <td class=\"center bold\">\r\n                {{ \"{:g}\".format(doc.total_qty) }}\r\n            </td>\r\n\r\n            <td><b>Sub Total</b></td>\r\n\r\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n\r\n        {% set ns = namespace(\r\n        total_before_tax=doc.net_total,\r\n        before_tax=[],\r\n        gst=[]\r\n        ) %}\r\n\r\n        {% if doc.taxes %}\r\n        {% for tax in doc.taxes %}\r\n        {% set account = frappe.get_cached_doc(\"Account\", tax.account_head) %}\r\n\r\n        {% if account.account_type == \"Tax\" %}\r\n        {% set _ = ns.gst.append(tax) %}\r\n        {% else %}\r\n        {% set _ = ns.before_tax.append(tax) %}\r\n        {% set ns.total_before_tax = tax.total %}\r\n        {% endif %}\r\n        {% endfor %}\r\n        {% endif %}\r\n\r\n        <!-- Charges Before Tax -->\r\n        {% for tax in ns.before_tax %}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                Add: {{ tax.description or tax.account_head }}\r\n                {% if tax.rate %}\r\n                ({{ \"{:g}\".format(tax.rate) }}%)\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"right\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n        <!-- Total Before Tax -->\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                <b>Total Before Tax</b>\r\n            </td>\r\n\r\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(ns.total_before_tax, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n\r\n        <!-- GST / Tax Accounts -->\r\n        {% for tax in ns.gst %}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                Add: {{ tax.description or tax.account_head }}\r\n                {% if tax.rate %}\r\n                ({{ \"{:g}\".format(tax.rate) }}%)\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"right\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n        <!-- Discount -->\r\n        {% if doc.discount_amount %}\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                Discount\r\n                {% if doc.additional_discount_percentage %}\r\n                ({{ doc.additional_discount_percentage }}%)\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"right\">\r\n                -{{ frappe.utils.fmt_money(doc.discount_amount, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n        {% endif %}\r\n\r\n        <!-- Total After Tax -->\r\n        <tr>\r\n            <td colspan=\"6\" class=\"right\">\r\n                <b>Total After Tax</b>\r\n            </td>\r\n\r\n            <td class=\"right bold\" style=\"white-space: nowrap;\">\r\n                {{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\r\n            </td>\r\n        </tr>\r\n\r\n\r\n        <tr>\r\n            <td colspan=\"7\" style=\"padding:8px;\">\r\n                <b>Amount in Words in Rs. :</b>\r\n                {{ doc.in_words }}\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n\r\n</table>\r\n\r\n\r\n<!-- Footer -->\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    {% if footer and not no_letterhead %}\r\n    {{ footer }}\r\n    {% endif %}\r\n</div>\r\n\r\n\r\n",
